# Token del bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=pega_aqui_tu_token

# ID del servidor (clic derecho en el server con modo desarrollador activado -> Copiar ID)
# Sirve para que los comandos / se sincronicen al instante en tu server (no en 1 hora)
GUILD_ID=pega_aqui_el_id_del_servidor

# Credenciales para acceder al Dashboard web en tiempo real (seguridad Basic Auth)
# Si las dejas vacías, no pedirá contraseña al entrar al dashboard.
DASHBOARD_USER=admin
DASHBOARD_PASS=cambiame_por_algo_seguro
